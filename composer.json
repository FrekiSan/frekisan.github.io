{
    "name": "frekisan/portfolio",
    "description": "Portfolio et projets (Escape Game, Jukebox rétro, Planning Keolis, etc.)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxime 'Freki' Orange",
            "email": "animaescape@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "mongodb/mongodb": "^2.1.1",
        "symfony/var-dumper": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
