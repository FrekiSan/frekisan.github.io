# ========= Application =========
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# ========= Base de données (alias génériques) =========
DB_HOST=db
DB_PORT=5432
DB_NAME=gevaudan
DB_USER=gevaudan
DB_PASSWORD=gevaudan

# ========= Base de données (variables attendues par docker-compose) =========
# Les valeurs par défaut se basent sur les DB_* ci-dessus quand c'est pertinent.
MYSQL_DATABASE=${DB_NAME}
MYSQL_USER=${DB_USER}
MYSQL_PASSWORD=${DB_PASSWORD}
# ATTENTION: valeur de dev par défaut; à surcharger en prod
MYSQL_ROOT_PASSWORD=gevaudan_root

# ========= Services (adapter si besoin) =========
PHP_FPM_PORT=9000
NGINX_PORT=8080
TOMCAT_PORT=8081

# Ne mets JAMAIS de secrets ici (ex: API_KEY=...)
